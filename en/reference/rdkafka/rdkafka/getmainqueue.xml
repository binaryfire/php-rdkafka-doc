<refentry xml:id="rdkafka.getmainqueue" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>RdKafka::getMainQueue</refname>
  <refpurpose>Get the main queue</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>RdKafka\Queue</type><methodname>RdKafka::getMainQueue</methodname>
   <void />
  </methodsynopsis>
  <para>
   Returns the queue that <function>RdKafka::poll</function> serves: delivery reports, errors, statistics and other callback events of a producer or low level consumer.
  </para>
  <para>
   Each call returns the same <classname>RdKafka\Queue</classname> object while it is in use. The queue keeps the client alive, and is invalidated when the client is destroyed.
  </para>
  <para>
   Use it to inspect the number of waiting events with <function>RdKafka\Queue::getLength</function>, or to be notified about new events with <function>RdKafka\Queue::ioEventEnable</function>. Keep serving the events with <function>RdKafka::poll</function>.
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Returns the main <classname>RdKafka\Queue</classname>.
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>RdKafka::poll</function></member>
    <member><function>RdKafka\Queue::ioEventEnable</function></member>
    <member><function>RdKafka\KafkaConsumer::getConsumerQueue</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

